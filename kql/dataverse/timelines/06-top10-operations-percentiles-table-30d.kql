// Source: Locally authored (generic Power Platform App Insights queries)
// TOP 10 Dataverse operations by p95 latency (last 30 days) — table view.
// Operation here = the readable operation_Name on the `requests` table
// (e.g. "Retrieve incident", "RetrieveMultiple account", "Update contact").
requests
| where timestamp > ago(30d)
| where isnotempty(operation_Name)
| summarize Calls = count(),
            p50   = percentile(duration, 50),
            p95   = percentile(duration, 95),
            p99   = percentile(duration, 99),
            Max   = max(duration),
            Failed = countif(success == false)
        by operation_Name
| where Calls > 100
| top 10 by p95 desc
