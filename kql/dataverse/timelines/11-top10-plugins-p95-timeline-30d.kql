// Source: Locally authored (generic Power Platform App Insights queries)
// TOP 10 plug-ins by p95 — daily p95 trend (last 30 days).
let _top = dependencies
    | where timestamp > ago(30d)
    | where type == "Plugin"
    | summarize Calls = count(), p95 = percentile(duration, 95) by name
    | where Calls > 50
    | top 10 by p95 desc
    | project name;
dependencies
| where timestamp > ago(30d)
| where type == "Plugin"
| where name in (_top)
| summarize p95 = percentile(duration, 95) by bin(timestamp, 1d), name
| render timechart
