{
  "name": "Live Dashboard - dataverse",
  "runtime": "appinsights",
  "description": "Run these KQL tiles against a customer environment, render results, and capture observations.",
  "sourceDashboard": "DASHBOARD-plugin-and-webapi-health.md",
  "minimumTargetTiles": 10,
  "maximumTargetTiles": 15,
  "tiles": [
    {
      "id": "tile-01",
      "title": "Top user agents calling Web API",
      "viz": "barchart",
      "queryFile": "01-requests-by-useragent.kql",
      "observationFocus": "Who/what is hitting the API"
    },
    {
      "id": "tile-02",
      "title": "Top 100 plug-in executions by latency",
      "viz": "table",
      "queryFile": "02-plugin-dependencies-top100.kql",
      "observationFocus": "Slowest single plug-in invocations"
    },
    {
      "id": "tile-03",
      "title": "SDK call breakdown",
      "viz": "table",
      "queryFile": "03-sdk-dependencies.kql",
      "observationFocus": "What SDK operations dominate `dependencies`"
    },
    {
      "id": "tile-04",
      "title": "Top 10 exception messages",
      "viz": "barchart",
      "queryFile": "04-exceptions-top10.kql",
      "observationFocus": "Headline exception list"
    },
    {
      "id": "tile-05",
      "title": "Exceptions per user",
      "viz": "table",
      "queryFile": "05-exceptions-by-user.kql",
      "observationFocus": "Which users hit the most server errors"
    },
    {
      "id": "tile-06",
      "title": "`Retrieve` / `RetrieveMultiple` cost",
      "viz": "table",
      "queryFile": "06-sdk-retrieve-dependencies.kql",
      "observationFocus": "Read-heavy callers"
    },
    {
      "id": "tile-07",
      "title": "Plug-in perf regressions",
      "viz": "columnchart",
      "queryFile": "07-plugin-perf-degradation.kql",
      "observationFocus": "Plug-ins that got slower across a window"
    },
    {
      "id": "tile-08",
      "title": "API latency timechart",
      "viz": "timechart",
      "queryFile": "08-api-perf-timechart.kql",
      "observationFocus": "API latency over time"
    },
    {
      "id": "tile-09",
      "title": "Plug-in usage \u00d7 performance",
      "viz": "scatterchart",
      "queryFile": "09-plugin-usage-perf.kql",
      "observationFocus": "Heavy callers vs slow ones"
    },
    {
      "id": "tile-10",
      "title": "Pull telemetry for `x-ms-service-request-id`",
      "viz": "table",
      "queryFile": "10-telemetry-by-request-id.kql",
