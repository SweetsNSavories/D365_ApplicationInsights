{
  "name": "Live Dashboard - modeldrivenapp",
  "runtime": "appinsights",
  "description": "Run these KQL tiles against a customer environment, render results, and capture observations.",
  "sourceDashboard": "DASHBOARD-uci-form-perf.md",
  "minimumTargetTiles": 10,
  "maximumTargetTiles": 15,
  "tiles": [
    {
      "id": "tile-01",
      "title": "Single `pageViews` sample",
      "viz": "table",
      "queryFile": "01-pageviews-take1.kql",
      "observationFocus": "Schema look \u2014 what fields/customDimensions are populated"
    },
    {
