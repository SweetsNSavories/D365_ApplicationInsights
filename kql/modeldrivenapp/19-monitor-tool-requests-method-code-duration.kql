// Source: aliyoussefi/MonitoringPowerPlatform/docs/02.03 - The Monitor Tool Part 2- Session Consumption and Analytics.md
// Browser request method, result code, duration and sync flag
requests
| extend cd   = parse_json(customDimensions)
| extend data = parse_json(tostring(cd.data))
| project
    session_Id, name,
    data.method, resultCode, data.name,
    data.duration, data.sync,
    cd.fileName
