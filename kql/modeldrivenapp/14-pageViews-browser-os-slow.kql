// Source: aliyoussefi/D365-Monitoring/KustoQueries.PageViews.txt
// Show how to check for specific browser and OS, filtered to slow pages
pageViews
| extend cm = parse_json(customMeasurements)
| extend cd = parse_json(customDimensions)
| where duration > 20
| where client_Browser !contains "Chrome"
| where client_OS contains "Windows"
