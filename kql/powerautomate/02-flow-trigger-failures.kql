// Source: MicrosoftDocs/power-platform / power-platform/admin/app-insights-cloud-flow.md
// Custom alert — failures for a specific cloud-flow trigger.
let myEnvironmentId = 'Insert your environment ID here';
let myTriggerName   = 'Insert your trigger name here';
dependencies
| where timestamp > ago(1d)
| where customDimensions['resourceProvider'] == 'Cloud Flow'
| where customDimensions['signalCategory']  == 'Cloud flow triggers'
| where customDimensions['environmentId']   == myEnvironmentId
| where name == myTriggerName
| where success == false
