// Source: microsoft/Dynamics-365-FastTrack-FSCM-Telemetry-Samples
// Upstream: https://github.com/microsoft/Dynamics-365-FastTrack-FSCM-Telemetry-Samples/blob/main/Dashboards/AzureDataExplorer/Forms/ADE-Dashboard-D365FO-Monitoring-Forms.json
// Tile: Form execution spread
//
// Parameters - adjust before running, or accept the defaults.
let _activityId    = "";        // empty = all; paste an activity id to scope
let _endTime       = now();     // dashboard window end
let _formName      = "";        // empty = all forms
let _startTime     = ago(7d);   // dashboard window start
let _userId        = "";        // empty = all users

pageViews
| extend ['Activity Id'] = customDimensions.activityId
| where timestamp between (_startTime .. _endTime)
| where isempty(['_userId']) or user_Id == ['_userId']
| where isempty(['_activityId']) or ['Activity Id'] in (['_activityId'])
| where isempty(['_formName']) or name == ['_formName']
| summarize Count = count() by bin(timestamp,1h)
