// Source: microsoft/Dynamics-365-FastTrack-FSCM-Telemetry-Samples
// Upstream: https://github.com/microsoft/Dynamics-365-FastTrack-FSCM-Telemetry-Samples/blob/main/Dashboards/AzureDataExplorer/Errors/dashboard-D365FO-Monitoring-Errors.json
// Tile: Errors by outer message
//
// Parameters - adjust before running, or accept the defaults.
let _endTime       = now();     // dashboard window end
let _startTime     = ago(7d);   // dashboard window start


exceptions
| where timestamp  between (_startTime .. _endTime)
| extend LegalEntity            = customDimensions.LegalEntity
    ,   ExecutionMode           = customDimensions.ExecutionMode
    ,   BatchJobId              = customDimensions.BatchJobId
    ,   CallStack               = customDimensions.CallStack
| project ["Timestamp"]             = timestamp
        , ["Outer Message"]          = outerMessage
        , ["Outer Message (short)"]          = tostring( split(tostring( split(outerMessage, "\\")[0]), ".")[0]) //substring( outerMessage,0,50)
        , ["Session ID"]            = session_Id
        , ["User ID"]               = user_Id
        , ["Legal Entity"]          = LegalEntity
        , ["Execution Mode"]        = tostring(ExecutionMode)
        , CallStack 
        , ["Client Type"]        = client_Type
        , ["Client City"]           = client_City
        , ["Client Country"]        = client_CountryOrRegion
| summarize ["Errors"] = count() by ["Outer Message (short)"]  // bin(["Timestamp"], totimespan(_time_span))
